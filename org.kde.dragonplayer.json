{
    "id": "org.kde.dragonplayer",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "dragon",
    "rename-icon": "dragonplayer",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--socket=fallback-x11"
    ],
    "modules": [
        {
            "name": "dragon",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/dragon-26.08.3.tar.xz",
                    "sha256": "b40f419c8ac5d16a36c39001b477b0a88d19ef1abd0c2671b47dc64d846a96e3",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/dragon-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
